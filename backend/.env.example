# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real a GitHub (ya está en .gitignore).

# Django
SECRET_KEY=pon-aqui-una-clave-secreta-larga-y-unica
DEBUG=True
ALLOWED_HOSTS=*

# Base de datos (formato URL de dj_database_url)
# Ejemplo local: postgres://usuario:password@localhost:5432/orbitcrm
DATABASE_URL=postgres://usuario:password@localhost:5432/orbitcrm

# AWS S3 (almacenamiento de archivos/media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2

# Correo (AWS SES / SMTP)
DEFAULT_FROM_EMAIL=
NOTIF_FROM_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
